       IDENTIFICATION DIVISION.
       PROGRAM-ID. STREAM-SHELL-FINANCE.

       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT LEDGER-FILE
               ASSIGN TO DYNAMIC WS-INPUT-PATH
               ORGANIZATION IS LINE SEQUENTIAL
               FILE STATUS IS WS-INPUT-STATUS.
           SELECT REPORT-FILE
               ASSIGN TO DYNAMIC WS-OUTPUT-PATH
               ORGANIZATION IS LINE SEQUENTIAL
               FILE STATUS IS WS-OUTPUT-STATUS.

       DATA DIVISION.
       FILE SECTION.

       FD  LEDGER-FILE.
       01  LEDGER-RECORD.
           05 LR-PROVIDER          PIC X(12).
           05 LR-STATUS            PIC X.
           05 LR-CADENCE           PIC X.
           05 LR-AMOUNT-CENTS      PIC 9(9).
           05 LR-BILLING           PIC X.

       FD  REPORT-FILE.
       01  REPORT-LINE             PIC X(80).

       WORKING-STORAGE SECTION.
       01  WS-ARG-COUNT            PIC 9(4) VALUE ZERO.
       01  WS-INPUT-PATH           PIC X(260) VALUE SPACES.
       01  WS-OUTPUT-PATH          PIC X(260) VALUE SPACES.
       01  WS-INPUT-STATUS         PIC XX VALUE SPACES.
       01  WS-OUTPUT-STATUS        PIC XX VALUE SPACES.
       01  WS-END-OF-FILE          PIC X VALUE "N".

       01  WS-BILLABLE-COUNT       PIC 9(4) VALUE ZERO.
       01  WS-ACTIVE-COUNT         PIC 9(4) VALUE ZERO.
       01  WS-ENDING-COUNT         PIC 9(4) VALUE ZERO.
       01  WS-MONTHLY-CENTS        PIC 9(12) VALUE ZERO.
       01  WS-ANNUAL-CENTS         PIC 9(12) VALUE ZERO.
       01  WS-DIRECT-CENTS         PIC 9(12) VALUE ZERO.
       01  WS-GOOGLE-CENTS         PIC 9(12) VALUE ZERO.
       01  WS-OTHER-CENTS          PIC 9(12) VALUE ZERO.
       01  WS-ITEM-MONTHLY         PIC 9(12) VALUE ZERO.
       01  WS-ITEM-ANNUAL          PIC 9(12) VALUE ZERO.

       01  WS-DISPLAY-COUNT        PIC 9(4) VALUE ZERO.
       01  WS-DISPLAY-AMOUNT       PIC 9(12) VALUE ZERO.

       PROCEDURE DIVISION.
       MAIN-PROCEDURE.
           ACCEPT WS-ARG-COUNT FROM ARGUMENT-NUMBER

           IF WS-ARG-COUNT < 2
               MOVE 2 TO RETURN-CODE
               STOP RUN
           END-IF

           ACCEPT WS-INPUT-PATH FROM ARGUMENT-VALUE
           ACCEPT WS-OUTPUT-PATH FROM ARGUMENT-VALUE

           OPEN INPUT LEDGER-FILE
           IF WS-INPUT-STATUS NOT = "00"
               MOVE 3 TO RETURN-CODE
               STOP RUN
           END-IF

           OPEN OUTPUT REPORT-FILE
           IF WS-OUTPUT-STATUS NOT = "00"
               CLOSE LEDGER-FILE
               MOVE 4 TO RETURN-CODE
               STOP RUN
           END-IF

           PERFORM UNTIL WS-END-OF-FILE = "Y"
               READ LEDGER-FILE
                   AT END
                       MOVE "Y" TO WS-END-OF-FILE
                   NOT AT END
                       PERFORM PROCESS-LEDGER-RECORD
               END-READ
           END-PERFORM

           PERFORM WRITE-REPORT

           CLOSE LEDGER-FILE
           CLOSE REPORT-FILE

           MOVE ZERO TO RETURN-CODE
           STOP RUN.

       PROCESS-LEDGER-RECORD.
           IF LR-STATUS NOT = "A" AND LR-STATUS NOT = "E"
               EXIT PARAGRAPH
           END-IF

           IF LR-AMOUNT-CENTS = ZERO
               EXIT PARAGRAPH
           END-IF

           ADD 1 TO WS-BILLABLE-COUNT

           IF LR-STATUS = "A"
               ADD 1 TO WS-ACTIVE-COUNT
           ELSE
               ADD 1 TO WS-ENDING-COUNT
           END-IF

           IF LR-CADENCE = "Y"
               DIVIDE LR-AMOUNT-CENTS BY 12
                   GIVING WS-ITEM-MONTHLY ROUNDED
               MOVE LR-AMOUNT-CENTS TO WS-ITEM-ANNUAL
           ELSE
               MOVE LR-AMOUNT-CENTS TO WS-ITEM-MONTHLY
               MULTIPLY LR-AMOUNT-CENTS BY 12
                   GIVING WS-ITEM-ANNUAL
           END-IF

           ADD WS-ITEM-MONTHLY TO WS-MONTHLY-CENTS
           ADD WS-ITEM-ANNUAL TO WS-ANNUAL-CENTS

           EVALUATE LR-BILLING
               WHEN "D"
                   ADD WS-ITEM-MONTHLY TO WS-DIRECT-CENTS
               WHEN "G"
                   ADD WS-ITEM-MONTHLY TO WS-GOOGLE-CENTS
               WHEN OTHER
                   ADD WS-ITEM-MONTHLY TO WS-OTHER-CENTS
           END-EVALUATE.

       WRITE-REPORT.
           MOVE "STATUS=OK" TO REPORT-LINE
           WRITE REPORT-LINE

           MOVE SPACES TO REPORT-LINE
           MOVE "ENGINE=GNUCOBOL" TO REPORT-LINE
           WRITE REPORT-LINE

           MOVE WS-BILLABLE-COUNT TO WS-DISPLAY-COUNT
           MOVE SPACES TO REPORT-LINE
           STRING "BILLABLE=" DELIMITED BY SIZE
                  WS-DISPLAY-COUNT DELIMITED BY SIZE
               INTO REPORT-LINE
           END-STRING
           WRITE REPORT-LINE

           MOVE WS-ACTIVE-COUNT TO WS-DISPLAY-COUNT
           MOVE SPACES TO REPORT-LINE
           STRING "ACTIVE=" DELIMITED BY SIZE
                  WS-DISPLAY-COUNT DELIMITED BY SIZE
               INTO REPORT-LINE
           END-STRING
           WRITE REPORT-LINE

           MOVE WS-ENDING-COUNT TO WS-DISPLAY-COUNT
           MOVE SPACES TO REPORT-LINE
           STRING "ENDING=" DELIMITED BY SIZE
                  WS-DISPLAY-COUNT DELIMITED BY SIZE
               INTO REPORT-LINE
           END-STRING
           WRITE REPORT-LINE

           MOVE WS-MONTHLY-CENTS TO WS-DISPLAY-AMOUNT
           MOVE SPACES TO REPORT-LINE
           STRING "MONTHLY_CENTS=" DELIMITED BY SIZE
                  WS-DISPLAY-AMOUNT DELIMITED BY SIZE
               INTO REPORT-LINE
           END-STRING
           WRITE REPORT-LINE

           MOVE WS-ANNUAL-CENTS TO WS-DISPLAY-AMOUNT
           MOVE SPACES TO REPORT-LINE
           STRING "ANNUAL_CENTS=" DELIMITED BY SIZE
                  WS-DISPLAY-AMOUNT DELIMITED BY SIZE
               INTO REPORT-LINE
           END-STRING
           WRITE REPORT-LINE

           MOVE WS-DIRECT-CENTS TO WS-DISPLAY-AMOUNT
           MOVE SPACES TO REPORT-LINE
           STRING "DIRECT_CENTS=" DELIMITED BY SIZE
                  WS-DISPLAY-AMOUNT DELIMITED BY SIZE
               INTO REPORT-LINE
           END-STRING
           WRITE REPORT-LINE

           MOVE WS-GOOGLE-CENTS TO WS-DISPLAY-AMOUNT
           MOVE SPACES TO REPORT-LINE
           STRING "GOOGLE_CENTS=" DELIMITED BY SIZE
                  WS-DISPLAY-AMOUNT DELIMITED BY SIZE
               INTO REPORT-LINE
           END-STRING
           WRITE REPORT-LINE

           MOVE WS-OTHER-CENTS TO WS-DISPLAY-AMOUNT
           MOVE SPACES TO REPORT-LINE
           STRING "OTHER_CENTS=" DELIMITED BY SIZE
                  WS-DISPLAY-AMOUNT DELIMITED BY SIZE
               INTO REPORT-LINE
           END-STRING
           WRITE REPORT-LINE.
